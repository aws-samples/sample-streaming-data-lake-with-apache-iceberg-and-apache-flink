<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- 
        OWASP Dependency Check Suppressions
        
        This file contains suppressions for known false positives or accepted risks
        in the Iceberg Flink Samples project.
        
        Each suppression should include:
        - A clear explanation of why it's suppressed
        - The CVE or vulnerability identifier
        - The affected package
        
        Review this file periodically and remove suppressions when:
        - The vulnerability is fixed in a newer version
        - The suppression is no longer needed
    -->

    <!-- 
        Hadoop vulnerabilities - these are in transitive dependencies and not exploitable
        in our use case (we don't expose Hadoop services externally)
    -->
    <suppress>
        <notes>Hadoop HDFS vulnerabilities - not applicable as we use S3 for storage</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.hadoop/hadoop-hdfs.*$</packageUrl>
        <cpe>cpe:/a:apache:hadoop</cpe>
    </suppress>

    <!-- 
        Flink vulnerabilities in provided scope - these are managed by AWS Managed Flink
        and not included in our application JAR
    -->
    <suppress>
        <notes>Flink provided dependencies - managed by AWS Managed Flink runtime</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.flink/flink-(streaming-java|clients|runtime).*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- 
        Jackson vulnerabilities - typically require specific deserialization patterns
        that we don't use (we use safe ObjectMapper configurations)
    -->
    <suppress>
        <notes>Jackson polymorphic deserialization - we use safe ObjectMapper configuration</notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\.core/jackson-databind.*$</packageUrl>
        <cve>CVE-2020-36518</cve>
    </suppress>

    <!-- 
        Netty vulnerabilities - transitive dependency, not directly exposed
    -->
    <suppress>
        <notes>Netty HTTP/2 vulnerabilities - not applicable, we don't expose HTTP/2 endpoints</notes>
        <packageUrl regex="true">^pkg:maven/io\.netty/netty.*$</packageUrl>
        <vulnerabilityName regex="true">CVE-2023-44487|CVE-2023-34462</vulnerabilityName>
    </suppress>

    <!-- 
        Protobuf vulnerabilities - transitive dependency from Hadoop/Iceberg
    -->
    <suppress>
        <notes>Protobuf vulnerabilities - transitive dependency, not directly used</notes>
        <packageUrl regex="true">^pkg:maven/com\.google\.protobuf/protobuf-java.*$</packageUrl>
        <vulnerabilityName regex="true">CVE-2022-3171|CVE-2022-3509|CVE-2022-3510</vulnerabilityName>
    </suppress>

</suppressions>
