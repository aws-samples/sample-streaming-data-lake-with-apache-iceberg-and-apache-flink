{
  "name": "iceberg-flink-cdk",
  "version": "1.0.0",
  "description": "CDK infrastructure for deploying Iceberg Flink samples to AWS Managed Flink",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "synth": "cdk synth",
    "nag": "cdk synth && echo 'CDK Nag checks completed'"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "aws-cdk": "^2.1111.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.240.0",
    "cdk-nag": "^2.28.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
