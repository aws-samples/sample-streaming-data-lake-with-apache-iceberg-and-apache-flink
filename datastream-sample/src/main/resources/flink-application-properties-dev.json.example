[
  {
    "PropertyGroupId": "FlinkApplicationProperties",
    "PropertyMap": {
      "kinesis.stream.arn": "arn:aws:kinesis:us-east-1:123456789012:stream/iceberg-events-datastream",
      "kinesis.region": "us-east-1",
      "aws.region": "us-east-1",
      "iceberg.catalog.name": "glue_catalog",
      "iceberg.catalog.type": "glue",
      "iceberg.database": "iceberg_datastream",
      "iceberg.table": "orders",
      "iceberg.warehouse": "s3://your-warehouse-bucket/warehouse",
      "checkpoint.interval.ms": "60000",
      "enable.maintenance": "false",
      "write.mode": "upsert",
      "primary.key.columns": "event_id,event_date,region"
    }
  }
]
